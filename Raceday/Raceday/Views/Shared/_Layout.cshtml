@{
    var user = Context.Session.GetUser();
    var error = ViewData["Error"] as string ?? TempData["Error"] as string;
    var success = TempData["Success"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "RaceDay") · RaceDay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;1,700&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<header class="rd-nav">
    <nav class="navbar navbar-expand-lg navbar-dark container">
        <a class="navbar-brand rd-brand" asp-controller="@(user?.IsOrganiser == true ? "Organiser" : "Home")" asp-action="@(user?.IsOrganiser == true ? "Dashboard" : "Index")">RACE<span>DAY</span></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav me-auto">
                @if (user?.IsParticipant == true)
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Events</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Enrolments">My Enrolments</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Results">My Results</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Profile">Profile</a></li>
                }
                else if (user?.IsOrganiser == true)
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Events">Manage Events</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Create">New Event</a></li>
                }
            </ul>
            <ul class="navbar-nav align-items-lg-center gap-lg-2">
                @if (user != null)
                {
                    <li class="nav-item text-white me-lg-2 small">@user.FullName <span class="role-chip">@user.Role</span></li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-light">Log out</button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li>
                    <li class="nav-item"><a class="btn btn-sm btn-gold" asp-controller="Account" asp-action="Register">Register</a></li>
                }
            </ul>
        </div>
    </nav>
</header>

<main class="container py-4">
    @if (!string.IsNullOrEmpty(success)) { <div class="alert alert-success" role="status">@success</div> }
    @if (!string.IsNullOrEmpty(error)) { <div class="alert alert-danger" role="alert">@error</div> }
    @RenderBody()
</main>

<footer class="rd-footer"><div class="container">RaceDay · Road running, walking and cycling events across South Africa</div></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
