@model List<EnrolmentDto>
@{ ViewData["Title"] = "My enrolments"; }
<h1 class="display-title">My enrolments</h1>
@if (!Model.Any())
{
    <div class="empty">You haven't entered any events yet. <a asp-controller="Home" asp-action="Index">Browse events</a></div>
}
else
{
    <div class="table-responsive"><table class="table rd-table align-middle">
        <thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Status</th></tr></thead>
        <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td><a asp-controller="Home" asp-action="Details" asp-route-id="@e.EventId">@e.EventName</a></td>
                <td>@e.EventDate.ToString("d MMM yyyy")</td>
                <td>@e.CategoryName</td>
                <td><partial name="_StatusBadge" model="e.Status" /></td>
            </tr>
        }
        </tbody></table></div>
}
