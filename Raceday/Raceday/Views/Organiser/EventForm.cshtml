@model EventFormVm
@{
    var editing = Model.Id > 0;
    ViewData["Title"] = editing ? "Edit event" : "New event";
}
<h1 class="display-title">@(editing ? "Edit event" : "New event")</h1>
<partial name="_ValidationSummary" />
<form method="post" enctype="multipart/form-data" asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.Id.ToString() : null)" novalidate>
    <input type="hidden" asp-for="ExistingBannerUrl" />
    <div class="row g-3">
        <div class="col-md-8"><label asp-for="Name" class="form-label">Event name</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
        <div class="col-md-4">
            <label asp-for="EventType" class="form-label">Type</label>
            <select asp-for="EventType" class="form-select">
                <option value="Run">Run</option><option value="Walk">Walk</option><option value="Cycle">Cycle</option>
            </select>
            <span asp-validation-for="EventType" class="text-danger small"></span>
        </div>
        <div class="col-12"><label asp-for="Description" class="form-label">Description</label><textarea asp-for="Description" rows="4" class="form-control"></textarea><span asp-validation-for="Description" class="text-danger small"></span></div>
        <div class="col-md-4"><label asp-for="Date" class="form-label">Date and start time</label><input asp-for="Date" type="datetime-local" class="form-control" /><span asp-validation-for="Date" class="text-danger small"></span></div>
        <div class="col-md-5"><label asp-for="Location" class="form-label">Location</label><input asp-for="Location" class="form-control" /><span asp-validation-for="Location" class="text-danger small"></span></div>
        <div class="col-md-3"><label asp-for="DistanceKm" class="form-label">Distance (km)</label><input asp-for="DistanceKm" type="number" step="0.1" class="form-control" /><span asp-validation-for="DistanceKm" class="text-danger small"></span></div>
        <div class="col-12">
            <label asp-for="Banner" class="form-label">Banner image</label>
            @if (!string.IsNullOrEmpty(Model.ExistingBannerUrl))
            { <div class="mb-2"><img src="@Model.ExistingBannerUrl" alt="Current banner" class="banner-preview" /><div class="small text-muted">Choose a new file to replace it.</div></div> }
            <input asp-for="Banner" type="file" accept="image/*" class="form-control" />
            <span asp-validation-for="Banner" class="text-danger small"></span>
        </div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button class="btn btn-gold" type="submit">@(editing ? "Save changes" : "Create event")</button>
        <a class="btn btn-outline-secondary" asp-action="Events">Cancel</a>
    </div>
</form>
