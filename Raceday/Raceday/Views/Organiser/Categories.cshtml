@model CategoriesVm
@{ ViewData["Title"] = "Categories"; }
<a asp-action="Events" class="small">&larr; All events</a>
<h1 class="display-title">Categories</h1>
<p class="meta">@Model.Event.Name · @Model.Event.Date.ToString("d MMM yyyy")</p>
<div class="row g-4">
    <div class="col-md-6">
        @if (!Model.Categories.Any()) { <div class="empty">No categories yet.</div> }
        else
        {
            <ul class="list-group">
            @foreach (var c in Model.Categories)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">@c.Name
                    <form asp-action="DeleteCategory" asp-route-eventId="@Model.Event.Id" asp-route-id="@c.Id" method="post"><button class="btn btn-sm btn-outline-danger" type="submit">Remove</button></form>
                </li>
            }
            </ul>
        }
    </div>
    <div class="col-md-6">
        <div class="panel">
            <h2 class="h5">Add category</h2>
            <form asp-action="Categories" asp-route-eventId="@Model.Event.Id" method="post" novalidate>
                <input asp-for="NewName" class="form-control" placeholder="e.g. 10km, Under 20, Senior" />
                <span asp-validation-for="NewName" class="text-danger small"></span>
                <button class="btn btn-gold mt-3" type="submit">Add</button>
            </form>
        </div>
    </div>
</div>
