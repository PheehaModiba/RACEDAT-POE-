@model EventListVm
@{ ViewData["Title"] = "Upcoming events"; }
<h1 class="display-title">Upcoming events</h1>
<form method="get" class="filter-bar row g-2 align-items-end mb-4">
    <div class="col-md-4"><label class="form-label" for="search">Search</label><input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Event or town" /></div>
    <div class="col-md-3">
        <label class="form-label" for="type">Type</label>
        <select id="type" name="type" class="form-select">
            <option value="">All</option>
            @foreach (var t in new[] { "Run", "Walk", "Cycle" })
            { <option value="@t" selected="@(string.Equals(Model.Type, t, StringComparison.OrdinalIgnoreCase))">@t</option> }
        </select>
    </div>
    <div class="col-md-3"><label class="form-label" for="maxDistance">Max distance (km)</label><input id="maxDistance" name="maxDistance" type="number" step="0.1" min="0" value="@Model.MaxDistance" class="form-control" /></div>
    <div class="col-md-2 d-flex gap-2"><button class="btn btn-gold flex-fill" type="submit">Filter</button><a class="btn btn-outline-secondary" asp-action="Index">Reset</a></div>
</form>

@if (!Model.Events.Any())
{
    <div class="empty">No upcoming events match your filters.</div>
}
else
{
    <div class="row g-4">
        @foreach (var e in Model.Events)
        { <div class="col-md-6 col-lg-4"><partial name="_EventCard" model="e" /></div> }
    </div>
}
