@model LoginVm
@{ ViewData["Title"] = "Log in"; }
<div class="auth-wrap">
    <h1 class="display-title">Line up</h1>
    <p class="text-muted">Log in to enter events, track results or manage your races.</p>
    <partial name="_ValidationSummary" />
    <form asp-action="Login" method="post" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label">Password</label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <button class="btn btn-gold w-100" type="submit">Log in</button>
    </form>
    <p class="mt-3 small">New here? <a asp-action="Register">Create an account</a></p>
</div>
